post_install() {
    modprobe uinput 2>/dev/null || true
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger /dev/uinput 2>/dev/null || true
    cat <<'EOF'

==> ShadowWhispr needs access to your keyboard devices:
==>   sudo usermod -aG input $USER
==> then log out and back in. An NVIDIA GPU is required for speech
==> recognition; the ~2-3 GB speech engine downloads on first run.
==> On GNOME, install/enable the AppIndicator extension for the tray icon.

EOF
}

post_upgrade() {
    post_install
}

<Window x:Class="ShadowWhispr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShadowWhispr" Width="1180" Height="820" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- Softer, wider shadows read better on the near-black violet base. -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="34" ShadowDepth="9" Opacity="0.42" Color="#05040C" />
        <!-- Luminous halo behind the brand mark only. -->
        <DropShadowEffect x:Key="BrandGlow" BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="#7C6BF2" />

        <!-- Midnight Aurora accent, used at reduced intensity for quiet labels -->
        <SolidColorBrush x:Key="EyebrowBrush" Color="{StaticResource GoldBright}" Opacity="0.72" />
        <SolidColorBrush x:Key="IconIdleBrush" Color="{StaticResource Muted}" />
        <LinearGradientBrush x:Key="AuroraBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A99BFF" Offset="0" />
            <GradientStop Color="#7C6BF2" Offset="0.45" />
            <GradientStop Color="#46D9F5" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AuroraFlatBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7C6BF2" Offset="0" />
            <GradientStop Color="#46D9F5" Offset="1" />
        </LinearGradientBrush>
        <!-- Card edge: brighter along the top so panels catch a hairline of light -->
        <LinearGradientBrush x:Key="CardEdgeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A4775" Offset="0" />
            <GradientStop Color="#2A2940" Offset="0.42" />
            <GradientStop Color="#232236" Offset="1" />
        </LinearGradientBrush>

        <!-- ============================ Typography ============================ -->
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource EyebrowBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <!-- Title of a card / block inside a section -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ============================== Surfaces ============================== -->
        <!-- The shadow lives on an empty border BEHIND the content. Putting the
             effect on the content border itself makes WPF rasterize everything
             inside it, which turns all the card text blurry. -->
        <Style x:Key="Card" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="16"
                                    Effect="{StaticResource CardShadow}" />
                            <Border BorderBrush="{StaticResource CardEdgeBrush}"
                                    BorderThickness="1" CornerRadius="16" Padding="24">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#191826" Offset="0" />
                                        <GradientStop Color="#12111C" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter />
                            </Border>
                            <!-- hairline of light along the top edge -->
                            <Border CornerRadius="16" Margin="1,1,1,0" IsHitTestVisible="False"
                                    BorderThickness="0,1,0,0">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#1FFFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2E7C6BF2" Offset="0" />
                        <GradientStop Color="#1A46D9F5" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#4D7C6BF2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- One stroked icon family: 20x20 canvas, 1.6 stroke, round caps -->
        <Style x:Key="CardIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource GoldBrightBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="Margin" Value="0,20,0,20" />
        </Style>

        <!-- One row of the Settings section: hairline-separated, quiet surface -->
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Background" Value="#0D0C18" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="13,7" />
        </Style>

        <!-- ========================= Sidebar navigation ========================= -->
        <!-- Nav rows are TabItems, so switching sections needs zero code-behind. -->
        <Style x:Key="NavItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,1,0,1">
                            <!-- The hand cursor belongs on the nav row itself. Setting it on
                                 the TabItem would inherit down into the whole section, which
                                 puts a hand over ordinary text and empty card space. -->
                            <Border x:Name="NavRow" Cursor="Hand" Background="Transparent" CornerRadius="10"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    Padding="14,10,12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <Canvas Width="20" Height="20">
                                            <!-- default: microphone; swapped per section below -->
                                            <Path x:Name="NavIcon"
                                                  Data="M 10,3 C 8.6,3 7.5,4.1 7.5,5.5 L 7.5,10 C 7.5,11.4 8.6,12.5 10,12.5 C 11.4,12.5 12.5,11.4 12.5,10 L 12.5,5.5 C 12.5,4.1 11.4,3 10,3 Z M 5,9.6 C 5,12.4 7.2,14.6 10,14.6 C 12.8,14.6 15,12.4 15,9.6 M 10,14.6 L 10,17 M 7.6,17 L 12.4,17"
                                                  Stroke="{StaticResource IconIdleBrush}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Fill="Transparent" />
                                        </Canvas>
                                    </Viewbox>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                                      TextElement.FontWeight="{TemplateBinding FontWeight}" />
                                </Grid>
                            </Border>
                            <Border x:Name="NavIndicator" Width="3" Height="20" CornerRadius="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{StaticResource AuroraBrush}" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Header" Value="AI Cleanup">
                                <Setter TargetName="NavIcon" Property="Data"
                                        Value="M 8.4,3 C 8.4,3 9.1,6.2 10.1,7.2 C 11.1,8.2 14.3,8.9 14.3,8.9 C 14.3,8.9 11.1,9.6 10.1,10.6 C 9.1,11.6 8.4,14.8 8.4,14.8 C 8.4,14.8 7.7,11.6 6.7,10.6 C 5.7,9.6 2.5,8.9 2.5,8.9 C 2.5,8.9 5.7,8.2 6.7,7.2 C 7.7,6.2 8.4,3 8.4,3 Z M 15,12.6 L 15.7,14.8 L 17.9,15.5 L 15.7,16.2 L 15,18.4 L 14.3,16.2 L 12.1,15.5 L 14.3,14.8 Z" />
                            </Trigger>
                            <Trigger Property="Header" Value="Transcript">
                                <Setter TargetName="NavIcon" Property="Data"
                                        Value="M 3.6,4.6 L 16.4,4.6 M 3.6,8.4 L 16.4,8.4 M 3.6,12.2 L 12.4,12.2 M 3.6,16 L 9,16" />
                            </Trigger>
                            <Trigger Property="Header" Value="Settings">
                                <Setter TargetName="NavIcon" Property="Data"
                                        Value="M 3,5.6 L 7.6,5.6 M 10.6,5.6 L 17,5.6 M 7.6,5.6 A 1.5,1.5 0 1 1 10.6,5.6 A 1.5,1.5 0 1 1 7.6,5.6 Z M 3,10.4 L 10.6,10.4 M 13.6,10.4 L 17,10.4 M 10.6,10.4 A 1.5,1.5 0 1 1 13.6,10.4 A 1.5,1.5 0 1 1 10.6,10.4 Z M 3,15.2 L 5.6,15.2 M 8.6,15.2 L 17,15.2 M 5.6,15.2 A 1.5,1.5 0 1 1 8.6,15.2 A 1.5,1.5 0 1 1 5.6,15.2 Z" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavRow" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                                <Setter TargetName="NavIcon" Property="Stroke" Value="{StaticResource TextBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavRow" Property="Background" Value="#237C6BF2" />
                                <Setter TargetName="NavRow" Property="BorderBrush" Value="#3D7C6BF2" />
                                <Setter TargetName="NavIcon" Property="Stroke" Value="{StaticResource GoldBrightBrush}" />
                                <Setter TargetName="NavIndicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab strip lives in the left rail; content fills the right pane. The
             brand block, engine pill and shared header are drawn over the empty
             top/bottom of the rail and the top of the content pane. -->
        <Style x:Key="ShellTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="228" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Margin="14,112,14,150" VerticalAlignment="Top">
                                <ItemsPresenter />
                            </Grid>
                            <Grid Grid.Column="1" Margin="0,104,0,0">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared padding for a section body -->
        <Style x:Key="SectionScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
            <Setter Property="Padding" Value="30,4,22,28" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0C0B16" Offset="0" />
                <GradientStop Color="#08070E" Offset="0.58" />
                <GradientStop Color="#0A0913" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Aurora ambience: one iris glow, one cyan glow, both barely there -->
        <Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-360,-320,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1C7C6BF2" Offset="0" />
                    <GradientStop Color="#007C6BF2" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-260,0,0,-300" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1246D9F5" Offset="0" />
                    <GradientStop Color="#0046D9F5" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Left rail surface (painted behind the tab strip) -->
        <Border Width="228" HorizontalAlignment="Left" Background="#CC100F1B"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0"
                IsHitTestVisible="False" />

        <!-- ============================== Sections ============================== -->
        <TabControl x:Name="SectionTabs" Style="{StaticResource ShellTabs}" TabStripPlacement="Left">

            <!-- ============================ Dictation ============================ -->
            <TabItem Header="Dictation" Tag="Pick the keys you speak with, and the microphone you speak into"
                     Style="{StaticResource NavItem}">
                <ScrollViewer Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <Viewbox Width="19" Height="19">
                                            <Canvas Width="20" Height="20">
                                                <Path Style="{StaticResource CardIcon}"
                                                      Data="M 10,3 C 8.6,3 7.5,4.1 7.5,5.5 L 7.5,10 C 7.5,11.4 8.6,12.5 10,12.5 C 11.4,12.5 12.5,11.4 12.5,10 L 12.5,5.5 C 12.5,4.1 11.4,3 10,3 Z M 5,9.6 C 5,12.4 7.2,14.6 10,14.6 C 12.8,14.6 15,12.4 15,9.6 M 10,14.6 L 10,17 M 7.6,17 L 12.4,17" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="VOICE CAPTURE" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="Hold to speak, or tap to stay on" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Your words appear in whichever app has focus."
                                                   Style="{StaticResource SectionCaption}" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Style="{StaticResource Divider}" />

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="DICTATION KEY — WITH AI CLEANUP" Style="{StaticResource FieldLabel}" />
                                        <Button x:Name="HotkeyCaptureButton"
                                                Content="Right Ctrl"
                                                Style="{StaticResource SecondaryButton}"
                                                HorizontalContentAlignment="Left"
                                                PreviewMouseLeftButtonDown="HotkeyCaptureMouseDown"
                                                PreviewKeyDown="HotkeyCaptureKeyDown"
                                                PreviewKeyUp="HotkeyCaptureKeyUp"
                                                LostKeyboardFocus="HotkeyCaptureLostFocus" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="DICTATION KEY — RAW TEXT, NO AI" Style="{StaticResource FieldLabel}" />
                                        <Button x:Name="RawHotkeyCaptureButton"
                                                Content="Not set"
                                                Style="{StaticResource SecondaryButton}"
                                                HorizontalContentAlignment="Left"
                                                PreviewMouseLeftButtonDown="HotkeyCaptureMouseDown"
                                                PreviewKeyDown="HotkeyCaptureKeyDown"
                                                PreviewKeyUp="HotkeyCaptureKeyUp"
                                                LostKeyboardFocus="HotkeyCaptureLostFocus" />
                                    </StackPanel>

                                    <TextBlock x:Name="HotkeyHint" Grid.Row="1" Grid.ColumnSpan="3"
                                               Margin="1,12,0,0" Style="{StaticResource Hint}"
                                               Text="Hold a key while you speak, or tap it quickly to keep recording hands-free until you press it again. Click a field, then press the key you want. Delete clears the optional hotkey; Escape cancels." />
                                </Grid>
                            </Grid>
                        </ContentControl>

                        <ContentControl Style="{StaticResource Card}" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}">
                                    <Viewbox Width="19" Height="19">
                                        <Canvas Width="20" Height="20">
                                            <Path Style="{StaticResource CardIcon}"
                                                  Data="M 3,9 L 3,11 M 6.5,6 L 6.5,14 M 10,3 L 10,17 M 13.5,6 L 13.5,14 M 17,9 L 17,11" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="INPUT DEVICE" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="Microphone" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Choose which device ShadowWhispr listens to."
                                               Style="{StaticResource SectionCaption}" Margin="0,5,0,14" />
                                    <ComboBox x:Name="MicCombo" DisplayMemberPath="Name" MaxWidth="520"
                                              HorizontalAlignment="Left" MinWidth="420"
                                              DropDownOpened="MicComboOpened" SelectionChanged="MicChanged" />
                                </StackPanel>
                            </Grid>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ AI cleanup ============================ -->
            <TabItem Header="AI Cleanup" Tag="Turn raw speech into text that is ready to send"
                     Style="{StaticResource NavItem}">
                <ScrollViewer Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <Viewbox Width="19" Height="19">
                                            <Canvas Width="20" Height="20">
                                                <Path Style="{StaticResource CardIcon}"
                                                      Data="M 8.4,3 C 8.4,3 9.1,6.2 10.1,7.2 C 11.1,8.2 14.3,8.9 14.3,8.9 C 14.3,8.9 11.1,9.6 10.1,10.6 C 9.1,11.6 8.4,14.8 8.4,14.8 C 8.4,14.8 7.7,11.6 6.7,10.6 C 5.7,9.6 2.5,8.9 2.5,8.9 C 2.5,8.9 5.7,8.2 6.7,7.2 C 7.7,6.2 8.4,3 8.4,3 Z M 15,12.6 L 15.7,14.8 L 17.9,15.5 L 15.7,16.2 L 15,18.4 L 14.3,16.2 L 12.1,15.5 L 14.3,14.8 Z" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                        <TextBlock Text="AI CLEANUP" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="Polish every transcript" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Punctuation and formatting are tidied by your chosen provider."
                                                   Style="{StaticResource SectionCaption}" />
                                    </StackPanel>
                                    <CheckBox x:Name="AiEnabledCheck" Grid.Column="2" Content="Enabled" FontWeight="SemiBold"
                                              VerticalAlignment="Center" Checked="AiToggleChanged" Unchecked="AiToggleChanged" />
                                </Grid>

                                <Border Style="{StaticResource Divider}" />

                                <Grid x:Name="AiOptions">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="1.55*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="PROVIDER" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ProviderCombo" SelectionChanged="ProviderChanged">
                                            <ComboBoxItem Content="Claude" />
                                            <ComboBoxItem Content="Codex" />
                                            <ComboBoxItem Content="Gemini" />
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="LoginButton" Content="Login" Padding="13,6" MinHeight="32" FontSize="12"
                                                    Click="LoginClicked" />
                                            <Button x:Name="LogoutButton" Content="Logout" Style="{StaticResource SecondaryButton}"
                                                    Padding="13,6" MinHeight="32" Margin="8,0,0,0" FontSize="12"
                                                    Click="LogoutClicked" />
                                        </StackPanel>
                                        <TextBlock x:Name="AuthStatus" Text="Checking login…" Margin="1,9,0,0"
                                                   Style="{StaticResource Hint}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ModelCombo" DisplayMemberPath="DisplayName" SelectionChanged="ModelChanged" />

                                        <!-- Only shown for models that actually offer Codex's fast speed tier. -->
                                        <Border x:Name="FastModePanel" Visibility="Collapsed"
                                                Background="#147C6BF2" BorderBrush="#3D7C6BF2" BorderThickness="1"
                                                CornerRadius="10" Padding="13,10" Margin="0,12,0,0">
                                            <StackPanel>
                                                <CheckBox x:Name="FastModeCheck" Content="Fast mode"
                                                          FontWeight="SemiBold" Checked="SettingsChanged"
                                                          Unchecked="SettingsChanged" />
                                                <TextBlock Margin="0,8,0,0" Style="{StaticResource Hint}"
                                                           Text="About 1.5x faster replies from Codex. It uses up your Codex usage allowance quicker than normal speed, so leave it off unless you want the extra speed." />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="REASONING" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ReasoningCombo" SelectionChanged="SettingsChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,24,0,0">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="CUSTOM CLEANUP INSTRUCTION" Style="{StaticResource FieldLabel}" Margin="0" />
                                            <TextBlock Grid.Column="1" Text="Drag the handle to resize"
                                                       Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="11" />
                                            </Grid.RowDefinitions>
                                            <TextBox x:Name="InstructionBox" Height="220" MinHeight="60" MaxHeight="420"
                                                     FontSize="14"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                                     TextChanged="SettingsChanged" />
                                            <Thumb Grid.Row="1" Cursor="SizeNS" DragDelta="InstructionResizeDragged"
                                                   ToolTip="Drag to resize the instruction box">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Grid Background="Transparent">
                                                            <Border Width="46" Height="4" CornerRadius="2"
                                                                    Background="{StaticResource LineStrongBrush}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ Transcript ============================ -->
            <TabItem Header="Transcript" Tag="The most recent result, exactly as it was typed out"
                     Style="{StaticResource NavItem}">
                <Grid Margin="30,4,22,28">
                    <ContentControl Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LAST TRANSCRIPT" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="Your most recent result" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Center">
                                    <TextBlock x:Name="RunStatus" Text="Waiting for speech"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBox x:Name="TranscriptBox" Grid.Row="1" MinHeight="260" Margin="0,18,0,0"
                                     FontSize="15"
                                     IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </ContentControl>
                </Grid>
            </TabItem>

            <!-- ============================= Settings ============================= -->
            <TabItem Header="Settings" Tag="How ShadowWhispr behaves on this PC"
                     Style="{StaticResource NavItem}">
                <ScrollViewer Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="PREFERENCES" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="App behaviour" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Everything here saves the moment you change it."
                                           Style="{StaticResource SectionCaption}" Margin="0,5,0,18" />

                                <Border Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="KeepRunningInTrayCheck"
                                              Content="Keep running in the tray when I close this window"
                                              FontSize="13" VerticalAlignment="Center"
                                              Checked="TrayOptionToggled" Unchecked="TrayOptionToggled" />
                                </Border>

                                <Border Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <CheckBox x:Name="StartWithWindowsCheck" Content="Start ShadowWhispr when Windows starts"
                                                  FontSize="13" VerticalAlignment="Center"
                                                  Checked="StartWithWindowsToggled" Unchecked="StartWithWindowsToggled" />
                                        <!-- Sub-option: only meaningful while autostart is on, so it greys
                                             itself out by following the checkbox above. -->
                                        <CheckBox x:Name="StartMinimizedCheck"
                                                  Content="Start minimized in the tray"
                                                  FontSize="13" Margin="31,11,0,0" VerticalAlignment="Center"
                                                  IsEnabled="{Binding IsChecked, ElementName=StartWithWindowsCheck}"
                                                  ToolTip="When Windows starts ShadowWhispr, keep it hidden in the tray instead of opening the window."
                                                  Checked="StartMinimizedToggled" Unchecked="StartMinimizedToggled" />
                                        <TextBlock x:Name="StartupStatus" Margin="31,9,0,0"
                                                   Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="MuteSoundCuesCheck"
                                              Content="Turn off the start and stop sounds"
                                              FontSize="13" VerticalAlignment="Center"
                                              Checked="SoundCuesToggled" Unchecked="SoundCuesToggled" />
                                </Border>

                                <Border Style="{StaticResource SettingRow}" Margin="0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="AutoUpdateCheck" Content="Automatically check for updates"
                                                      FontSize="13" VerticalAlignment="Center"
                                                      Checked="AutoUpdateToggled" Unchecked="AutoUpdateToggled" />
                                            <Button x:Name="CheckUpdatesButton" Grid.Column="1" Content="Check now"
                                                    Style="{StaticResource SecondaryButton}" Padding="12,5" MinHeight="0"
                                                    FontSize="12" Click="CheckForUpdatesClicked" />
                                        </Grid>
                                        <TextBlock x:Name="UpdateStatus" Margin="31,7,0,0"
                                                   Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#234FE0C0"
                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontSize="13"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PRIVACY" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="Audio is deleted immediately after transcription."
                                               Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ===================== Left rail: brand and engine ===================== -->
        <!-- No Background on this grid, so the empty middle lets nav clicks through. -->
        <Grid Width="228" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="104" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="20,0,16,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Brand mark: a soft-cornered shadow silhouette with a luminous
                     whisper arc running through it, drawn entirely in XAML. -->
                <Grid Width="46" Height="46" VerticalAlignment="Center">
                    <Viewbox Width="46" Height="46">
                        <Canvas Width="48" Height="48">
                            <Path Effect="{StaticResource BrandGlow}"
                                  Data="M 24,3.5 C 33.1,3.5 40.5,10.9 40.5,20 L 40.5,31.5 C 40.5,38.7 34.7,44.5 27.5,44.5 L 20.5,44.5 C 13.3,44.5 7.5,38.7 7.5,31.5 L 7.5,20 C 7.5,10.9 14.9,3.5 24,3.5 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#A99BFF" Offset="0" />
                                        <GradientStop Color="#7C6BF2" Offset="0.42" />
                                        <GradientStop Color="#46D9F5" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <Path Data="M 19.8,20.8 A 5,5 0 0 1 19.8,27.2 M 22.5,18.5 A 8.5,8.5 0 0 1 22.5,29.5 M 25.2,16.3 A 12,12 0 0 1 25.2,31.7"
                                  Stroke="#0B0A14" StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                            <Path Data="M 12.6,24 A 2.4,2.4 0 1 1 17.4,24 A 2.4,2.4 0 1 1 12.6,24 Z"
                                  Fill="#0B0A14" />
                        </Canvas>
                    </Viewbox>
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ShadowWhispr" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="VOICE TO TEXT" Foreground="{StaticResource MutedBrush}"
                               FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Margin="16,0,16,22" VerticalAlignment="Bottom">
                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,16" />
                <Border Style="{StaticResource Pill}" CornerRadius="12" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="11" Height="11" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Ellipse Fill="#2A4FE0C0" Width="11" Height="11" />
                            <Ellipse x:Name="EngineDot" Width="7" Height="7" Fill="{StaticResource GoldBrush}" />
                        </Grid>
                        <TextBlock x:Name="EngineStatus" Text="Loading Parakeet…" FontSize="12"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="132" />
                    </StackPanel>
                </Border>
                <Button x:Name="PauseButton" Content="Pause dictation"
                        Style="{StaticResource SecondaryButton}" Padding="12,8" MinHeight="0"
                        FontSize="12" Margin="0,10,0,0" Click="PauseClicked"
                        ToolTip="Hand your hotkeys back to other apps until you resume" />
            </StackPanel>
        </Grid>

        <!-- ======================= Shared content header ======================= -->
        <Grid Height="104" VerticalAlignment="Top" Margin="228,0,0,0">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" />
            <Grid Margin="30,0,30,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ElementName=SectionTabs, Path=SelectedItem.Header}"
                               FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ElementName=SectionTabs, Path=SelectedItem.Tag}"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border x:Name="SaveStatusPill" Grid.Column="1" Style="{StaticResource Pill}"
                        Margin="20,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SaveDot" Width="9" Height="9" Margin="0,0,8,0"
                                 VerticalAlignment="Center" Fill="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="SaveStatus" Text="Settings save automatically"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- First-run speech setup overlay (shown only when .venv is missing) -->
        <Border x:Name="SetupBanner" Visibility="Collapsed" Background="#E606050D" Panel.ZIndex="50">
            <ContentControl Style="{StaticResource Card}" MaxWidth="560" Margin="24"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="ONE-TIME SETUP" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="Set up the speech engine" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13"
                               Margin="0,12,0,0" LineHeight="20">
                        ShadowWhispr needs to download its local speech engine
                        (about 2–3 GB). This happens once. Nothing is installed
                        on your PC outside this app — no admin needed. An NVIDIA
                        GPU is required.
                    </TextBlock>
                    <Border Background="#14171630" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="13,10" Margin="0,14,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12">
                            You can leave this running and use your PC normally. Progress
                            is shown here, and everything is also saved to setup-log.txt.
                        </TextBlock>
                    </Border>

                    <!-- Progress readout, hidden until setup is actually running -->
                    <StackPanel x:Name="SetupProgressPanel" Visibility="Collapsed" Margin="0,18,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SetupStepText" Text="Starting setup…" FontSize="13"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SetupPercentText" Grid.Column="1" Text="0%" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                        <Border x:Name="SetupProgressTrack" Height="10" CornerRadius="5" Background="#0B0A14"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                SizeChanged="SetupProgressTrackSizeChanged">
                            <Grid HorizontalAlignment="Stretch">
                                <Border x:Name="SetupProgressFill" Width="0" HorizontalAlignment="Left"
                                        CornerRadius="5" Background="{StaticResource AuroraFlatBrush}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="Big downloads can sit on one step for a while — that's normal."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0" VerticalAlignment="Center">
                        <Button x:Name="SetupRunButton" Content="Set up speech now" Padding="20,11"
                                FontWeight="SemiBold" Click="SetupRunClicked" />
                        <Button x:Name="SetupLogButton" Content="Open setup log" Style="{StaticResource SecondaryButton}"
                                Padding="14,8" MinHeight="0" FontSize="12" Margin="10,0,0,0"
                                Visibility="Collapsed" Click="OpenSetupLogClicked" />
                    </StackPanel>
                    <TextBlock x:Name="SetupStatus" Margin="1,12,0,0"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </ContentControl>
        </Border>
    </Grid>
</Window>

<Window x:Class="ShadowWhispr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShadowWhispr" Width="920" Height="900" MinWidth="760" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="8" Opacity="0.25" Color="#000000" />

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        </Style>

        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="#22DDB45F" />
            <Setter Property="BorderBrush" Value="#52DDB45F" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#11161D" Offset="0" />
                <GradientStop Color="#0C0F13" Offset="0.55" />
                <GradientStop Color="#15120D" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-310,-290,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#20DDB45F" Offset="0" />
                    <GradientStop Color="#00DDB45F" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <Grid MaxWidth="980" Margin="34,28,34,30">
                <!-- Scaled up on larger / higher-resolution surfaces so text stays
                     readable on 1440p and 4K. Factor set in OnWindowSizeChanged. -->
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="2,0,2,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="52" Height="52" CornerRadius="14" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource GoldBright}" Offset="0" />
                                <GradientStop Color="{StaticResource GoldDark}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.28" Color="#DDB45F" />
                        </Border.Effect>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="4" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="2" Height="9" CornerRadius="1" Background="#211A0D" />
                            <Border Grid.Column="1" Width="2" Height="19" CornerRadius="1" Background="#211A0D" />
                            <Border Grid.Column="2" Width="2" Height="27" CornerRadius="1" Background="#211A0D" />
                            <Border Grid.Column="3" Width="2" Height="16" CornerRadius="1" Background="#211A0D" />
                            <Border Grid.Column="4" Width="2" Height="7" CornerRadius="1" Background="#211A0D" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SHADOWWHISPR" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="Voice to text, without the friction" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="#C915191F" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="18" Padding="13,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="11" Height="11" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Ellipse Fill="#2566D39A" Width="11" Height="11" />
                                <Ellipse x:Name="EngineDot" Width="7" Height="7" Fill="{StaticResource GoldBrush}" />
                            </Grid>
                            <TextBlock x:Name="EngineStatus" Text="Loading Parakeet…" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}">
                                <Viewbox Width="21" Height="21">
                                    <Path Data="M 10,2 C 7.8,2 6,3.8 6,6 L 6,11 C 6,13.2 7.8,15 10,15 C 12.2,15 14,13.2 14,11 L 14,6 C 14,3.8 12.2,2 10,2 M 3.5,10.5 C 3.5,14.1 6.4,17 10,17 C 13.6,17 16.5,14.1 16.5,10.5 M 10,17 L 10,20 M 7,20 L 13,20"
                                          Stroke="{StaticResource GoldBrightBrush}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="VOICE CAPTURE" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="Hold, speak, release" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                <TextBlock Text="Your words appear in the selected app." Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Column="1" Width="1" Background="{StaticResource LineBrush}" Margin="24,0" />

                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="HOLD-TO-TALK HOTKEY" Style="{StaticResource FieldLabel}" />
                                <Button x:Name="HotkeyCaptureButton"
                                        Content="Right Ctrl"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalContentAlignment="Left"
                                        PreviewMouseLeftButtonDown="HotkeyCaptureMouseDown"
                                        PreviewKeyDown="HotkeyCaptureKeyDown"
                                        PreviewKeyUp="HotkeyCaptureKeyUp"
                                        LostKeyboardFocus="HotkeyCaptureLostFocus" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SPEECH MODEL" Style="{StaticResource FieldLabel}" />
                                <Border Height="42" Background="#10141A" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" CornerRadius="9" Padding="13,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Parakeet v3" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AI CLEANUP" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="Make every transcript ready to use" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Text="Polish punctuation and formatting with your chosen AI provider."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="AiEnabledCheck" Grid.Column="1" Content="Enabled" FontWeight="SemiBold"
                                      VerticalAlignment="Center" Checked="AiToggleChanged" Unchecked="AiToggleChanged" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,22" />

                        <Border Background="#14DDB45F" BorderBrush="#3ADDB45F" BorderThickness="1"
                                CornerRadius="12" Padding="16,13" Margin="0,0,0,22">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="★" Foreground="{StaticResource GoldBrush}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="RECOMMENDED MODELS FOR THE BEST EXPERIENCE"
                                               Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                                </StackPanel>
                                <WrapPanel>
                                    <Border Background="#12FFFFFF" BorderBrush="#33DDB45F" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource GoldBrush}"
                                                     Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock FontSize="12.5" VerticalAlignment="Center">
                                                <Run Text="GPT 5.6 Sol" FontWeight="SemiBold" />
                                                <Run Text="  ·  medium reasoning" Foreground="{StaticResource MutedBrush}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#12FFFFFF" BorderBrush="#33DDB45F" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource GoldBrush}"
                                                     Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Gemini 3.1 Pro" FontSize="12.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#12FFFFFF" BorderBrush="#33DDB45F" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource GoldBrush}"
                                                     Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Claude Opus" FontSize="12.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="AiOptions">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1.55*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="PROVIDER" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ProviderCombo" SelectionChanged="ProviderChanged">
                                    <ComboBoxItem Content="Claude" />
                                    <ComboBoxItem Content="Codex" />
                                    <ComboBoxItem Content="Gemini" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="LoginButton" Content="Login" Padding="13,6" MinHeight="32" FontSize="12"
                                            Click="LoginClicked" />
                                    <Button x:Name="LogoutButton" Content="Logout" Style="{StaticResource SecondaryButton}"
                                            Padding="13,6" MinHeight="32" Margin="8,0,0,0" FontSize="12"
                                            Click="LogoutClicked" />
                                </StackPanel>
                                <TextBlock x:Name="AuthStatus" Text="Checking login…" Margin="1,8,0,0"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ModelCombo" DisplayMemberPath="DisplayName" SelectionChanged="ModelChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="REASONING" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ReasoningCombo" SelectionChanged="SettingsChanged" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,24,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CUSTOM CLEANUP INSTRUCTION" Style="{StaticResource FieldLabel}" Margin="0" />
                                    <TextBlock Grid.Column="1" Text="Drag the handle to resize" Foreground="{StaticResource MutedBrush}"
                                               FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="11" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="InstructionBox" Height="360" MinHeight="60" MaxHeight="360"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                             TextChanged="SettingsChanged" />
                                    <Thumb Grid.Row="1" Cursor="SizeNS" DragDelta="InstructionResizeDragged"
                                           ToolTip="Drag to resize the instruction box">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Border Width="46" Height="4" CornerRadius="2"
                                                            Background="{StaticResource LineStrongBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="LAST TRANSCRIPT" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="Your most recent result" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1810141A" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="14" Padding="11,6" VerticalAlignment="Center">
                                <TextBlock x:Name="RunStatus" Text="Waiting for speech" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBox x:Name="TranscriptBox" Grid.Row="1" Height="140" Margin="0,18,0,0"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <Grid Grid.Row="4" Margin="3,20,3,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#1C66D39A" Margin="0,0,9,0">
                                <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontSize="13"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Audio is deleted immediately after transcription."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <CheckBox x:Name="AutoUpdateCheck" Content="Automatically check for updates"
                                      FontSize="13" VerticalAlignment="Center"
                                      Checked="AutoUpdateToggled" Unchecked="AutoUpdateToggled" />
                            <Button x:Name="CheckUpdatesButton" Content="Check now"
                                    Style="{StaticResource SecondaryButton}" Padding="12,5" MinHeight="0"
                                    FontSize="12" Margin="14,0,0,0" Click="CheckForUpdatesClicked" />
                            <TextBlock x:Name="UpdateStatus" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="SaveButton" Grid.Column="1" Content="Save settings" Padding="20,10"
                            VerticalAlignment="Top" Click="SaveClicked" />
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- First-run speech setup overlay (shown only when .venv is missing) -->
        <Border x:Name="SetupBanner" Visibility="Collapsed" Background="#D60A0D11" Panel.ZIndex="50">
            <Border Style="{StaticResource Card}" MaxWidth="540" Margin="24"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="ONE-TIME SETUP" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="Set up the speech engine" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13"
                               Margin="0,12,0,0" LineHeight="20">
                        ShadowWhispr needs to download its local speech engine
                        (about 2–3 GB). This happens once. If Python 3.12 isn't
                        installed, it will be installed for you automatically — no
                        admin needed. An NVIDIA GPU is required.
                    </TextBlock>
                    <Border Background="#141A1E14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="9" Padding="12,9" Margin="0,14,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12">
                            A PowerShell window will open so you can watch progress. It's
                            safe to leave it running — it closes itself when finished.
                        </TextBlock>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0" VerticalAlignment="Center">
                        <Button x:Name="SetupRunButton" Content="Set up speech now" Padding="20,11"
                                FontWeight="SemiBold" Click="SetupRunClicked" />
                        <TextBlock x:Name="SetupStatus" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

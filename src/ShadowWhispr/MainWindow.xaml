<Window x:Class="ShadowWhispr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShadowWhispr" Width="760" Height="1380" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="2,0,2,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SHADOWWHISPR" FontSize="25" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" />
                <TextBlock Text="Local voice typing for Windows" Foreground="{StaticResource MutedBrush}" Margin="1,3,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="13,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="EngineDot" Width="9" Height="9" Fill="#E7B85C" Margin="0,0,8,0" />
                    <TextBlock x:Name="EngineStatus" Text="Loading Parakeet…" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Hold-to-talk hotkey · click to change" Style="{StaticResource Label}" />
                    <Button x:Name="HotkeyCaptureButton"
                            Content="Right Ctrl"
                            Background="{StaticResource PanelRaisedBrush}"
                            Foreground="{StaticResource TextBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            FontWeight="Normal"
                            HorizontalContentAlignment="Left"
                            PreviewMouseLeftButtonDown="HotkeyCaptureMouseDown"
                            PreviewKeyDown="HotkeyCaptureKeyDown"
                            PreviewKeyUp="HotkeyCaptureKeyUp"
                            LostKeyboardFocus="HotkeyCaptureLostFocus" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Speech model" Style="{StaticResource Label}" />
                    <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="11,9">
                        <TextBlock Text="Parakeet v3 · 25 languages" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <CheckBox x:Name="AiEnabledCheck" Content="Clean up the transcript with AI" FontWeight="SemiBold"
                          Checked="AiToggleChanged" Unchecked="AiToggleChanged" />
                <Grid x:Name="AiOptions" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Provider" Style="{StaticResource Label}" />
                        <ComboBox x:Name="ProviderCombo" SelectionChanged="ProviderChanged">
                            <ComboBoxItem Content="Claude" />
                            <ComboBoxItem Content="Codex" />
                            <ComboBoxItem Content="Gemini" />
                            <ComboBoxItem Content="Kimi" />
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="LoginButton" Content="Login" Padding="11,5" FontSize="11"
                                    Click="LoginClicked" />
                            <Button x:Name="LogoutButton" Content="Logout" Padding="11,5" Margin="7,0,0,0"
                                    FontSize="11" Background="{StaticResource PanelRaisedBrush}"
                                    Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" Click="LogoutClicked" />
                        </StackPanel>
                        <TextBlock x:Name="AuthStatus" Text="Checking login…" Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Model" Style="{StaticResource Label}" />
                        <ComboBox x:Name="ModelCombo" DisplayMemberPath="DisplayName" SelectionChanged="ModelChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Reasoning" Style="{StaticResource Label}" />
                        <ComboBox x:Name="ReasoningCombo" SelectionChanged="SettingsChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,14,0,0">
                        <TextBlock Text="Custom cleanup instruction" Style="{StaticResource Label}" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="InstructionBox" Height="480" MinHeight="60" MaxHeight="480"
                                     AcceptsReturn="True" TextWrapping="Wrap" Background="#11161C"
                                     Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}"
                                     VerticalScrollBarVisibility="Auto" TextChanged="SettingsChanged">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.65" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <Thumb Grid.Row="1" Cursor="SizeNS" DragDelta="InstructionResizeDragged"
                                   ToolTip="Drag to resize the instruction box">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Border Width="42" Height="3" CornerRadius="2"
                                                    Background="{StaticResource LineBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Last transcript" FontWeight="SemiBold" />
                    <TextBlock x:Name="RunStatus" Grid.Column="1" Text="Waiting for speech" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </Grid>
                <TextBox x:Name="TranscriptBox" Grid.Row="1" Margin="0,11,0,0" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="2,15,2,0">
            <TextBlock Text="Audio is deleted immediately after transcription." Foreground="{StaticResource MutedBrush}"
                       FontSize="12" VerticalAlignment="Center" />
            <Button x:Name="SaveButton" Content="Save settings" HorizontalAlignment="Right" Click="SaveClicked" />
        </Grid>
    </Grid>
</Window>

<Window x:Class="ShadowWhispr.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="178" Height="46"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" IsHitTestVisible="False"
        ShowActivated="False" Focusable="False">
    <Border Background="#E612171D" BorderBrush="#5A687786" BorderThickness="1"
            CornerRadius="23" Padding="13,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="Center">
                <Ellipse x:Name="Glow" Fill="#55DF4A4A" />
                <Ellipse x:Name="Led" Width="10" Height="10" Fill="#DF4A4A" />
            </Grid>
            <TextBlock x:Name="StatusLabel" Grid.Column="1" Text="Ready" FontSize="12"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0" />
        </Grid>
    </Border>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShadowWhispr.Linux.MainWindow"
        Title="ShadowWhispr" Width="980" Height="960" MinWidth="760" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="avares://shadowwhispr/Assets/icon.png"
        Foreground="{StaticResource TextBrush}">
    <Window.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#11161D" Offset="0" />
            <GradientStop Color="#0C0F13" Offset="0.55" />
            <GradientStop Color="#15120D" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Panel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="980" Margin="34,28,34,30" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                <!-- Header -->
                <Grid Margin="2,0,2,26" ColumnDefinitions="Auto,*,Auto">
                    <Border Width="52" Height="52" CornerRadius="14" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="{StaticResource GoldBright}" Offset="0" />
                                <GradientStop Color="{StaticResource GoldDark}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="2" Height="9" CornerRadius="1" Background="#211A0D" VerticalAlignment="Center" />
                            <Border Width="2" Height="19" CornerRadius="1" Background="#211A0D" VerticalAlignment="Center" />
                            <Border Width="2" Height="27" CornerRadius="1" Background="#211A0D" VerticalAlignment="Center" />
                            <Border Width="2" Height="16" CornerRadius="1" Background="#211A0D" VerticalAlignment="Center" />
                            <Border Width="2" Height="7" CornerRadius="1" Background="#211A0D" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SHADOWWHISPR" Classes="eyebrow" />
                        <TextBlock Text="Voice to text, without the friction" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                        <Button x:Name="PauseButton" Content="Pause dictation" Classes="secondary"
                                Padding="14,7" MinHeight="0" FontSize="12" Click="PauseClicked"
                                ToolTip.Tip="Hand your hotkeys back to other apps until you resume" />
                        <Border Background="#C915191F" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="18" Padding="13,8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Ellipse x:Name="EngineDot" Width="9" Height="9" Fill="{StaticResource GoldBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="EngineStatus" Text="Loading Parakeet…" FontSize="12"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Voice capture card -->
                <Border Grid.Row="1" Classes="card" Margin="0,0,0,18">
                    <Grid ColumnDefinitions="1.05*,Auto,1.15*">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="VOICE CAPTURE" Classes="eyebrow" />
                            <TextBlock Text="Hold to speak, or tap to stay on" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Your words appear in the selected app." Classes="muted"
                                       FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="{StaticResource LineBrush}" Margin="24,0" />

                        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,16,*">
                            <StackPanel>
                                <TextBlock Text="DICTATION KEY — WITH AI CLEANUP" Classes="fieldLabel" />
                                <Button x:Name="HotkeyCaptureButton" Content="Right Ctrl" Classes="secondary"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Click="HotkeyCaptureClicked" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DICTATION KEY — RAW TEXT, NO AI" Classes="fieldLabel" />
                                <Button x:Name="RawHotkeyCaptureButton" Content="Not set" Classes="secondary"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Click="HotkeyCaptureClicked" />
                            </StackPanel>
                            <TextBlock x:Name="HotkeyHint" Grid.Row="1" Grid.ColumnSpan="3" Margin="1,9,0,0"
                                       Classes="muted" FontSize="11" TextWrapping="Wrap"
                                       Text="Hold a key while you speak, or tap it quickly to keep recording hands-free until you press it again. Click a field, then press the key you want. Delete clears the optional hotkey; Escape cancels." />
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
                                <TextBlock Text="MICROPHONE" Classes="fieldLabel" />
                                <ComboBox x:Name="MicCombo" DropDownOpened="MicComboOpened" SelectionChanged="MicChanged" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- AI cleanup card -->
                <Border Grid.Row="2" Classes="card" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="5">
                                <TextBlock Text="AI CLEANUP" Classes="eyebrow" />
                                <TextBlock Text="Make every transcript ready to use" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="Polish punctuation and formatting with your chosen AI provider."
                                           Classes="muted" FontSize="12" />
                            </StackPanel>
                            <CheckBox x:Name="AiEnabledCheck" Grid.Column="1" Content="Enabled" FontWeight="SemiBold"
                                      VerticalAlignment="Center" IsCheckedChanged="AiToggleChanged" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,22" />

                        <Grid x:Name="AiOptions" RowDefinitions="Auto,Auto" ColumnDefinitions="1.15*,18,1.55*,18,1*">
                            <StackPanel>
                                <TextBlock Text="PROVIDER" Classes="fieldLabel" />
                                <ComboBox x:Name="ProviderCombo" SelectionChanged="ProviderChanged">
                                    <ComboBoxItem Content="Claude" />
                                    <ComboBoxItem Content="Codex" />
                                    <ComboBoxItem Content="Gemini" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Spacing="8">
                                    <Button x:Name="LoginButton" Content="Login" Padding="13,6" MinHeight="32"
                                            FontSize="12" Click="LoginClicked" />
                                    <Button x:Name="LogoutButton" Content="Logout" Classes="secondary"
                                            Padding="13,6" MinHeight="32" FontSize="12" Click="LogoutClicked" />
                                </StackPanel>
                                <TextBlock x:Name="AuthStatus" Text="Checking login…" Margin="1,8,0,0"
                                           Classes="muted" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MODEL" Classes="fieldLabel" />
                                <ComboBox x:Name="ModelCombo" SelectionChanged="ModelChanged" />

                                <!-- Only shown for models that actually offer Codex's fast speed tier. -->
                                <Border x:Name="FastModePanel" IsVisible="False"
                                        Background="#12FFFFFF" BorderBrush="#33DDB45F" BorderThickness="1"
                                        CornerRadius="8" Padding="12,9" Margin="0,12,0,0">
                                    <StackPanel Spacing="7">
                                        <CheckBox x:Name="FastModeCheck" Content="Fast mode"
                                                  FontWeight="SemiBold" IsCheckedChanged="SettingsChanged" />
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Classes="muted"
                                                   Text="About 1.5x faster replies from Codex. It uses up your Codex usage allowance quicker than normal speed, so leave it off unless you want the extra speed." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="REASONING" Classes="fieldLabel" />
                                <ComboBox x:Name="ReasoningCombo" SelectionChanged="SettingsChanged" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,24,0,0">
                                <TextBlock Text="CUSTOM CLEANUP INSTRUCTION" Classes="fieldLabel" />
                                <TextBox x:Name="InstructionBox" Height="300" FontSize="15"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" TextChanged="SettingsChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Last transcript card -->
                <Border Grid.Row="3" Classes="card">
                    <Grid RowDefinitions="Auto,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="LAST TRANSCRIPT" Classes="eyebrow" />
                                <TextBlock Text="Your most recent result" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1810141A" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="14" Padding="11,6" VerticalAlignment="Center">
                                <TextBlock x:Name="RunStatus" Text="Waiting for speech" Classes="muted"
                                           FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBox x:Name="TranscriptBox" Grid.Row="1" Height="140" Margin="0,18,0,0"
                                 FontSize="15" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" />
                    </Grid>
                </Border>

                <!-- Footer options -->
                <Grid Grid.Row="4" Margin="3,20,3,0" ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#1C66D39A">
                                <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontSize="13"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Audio is deleted immediately after transcription."
                                       Classes="muted" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox x:Name="KeepRunningInTrayCheck"
                                  Content="Keep running in the tray when I close this window"
                                  FontSize="13" IsCheckedChanged="TrayOptionToggled" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <CheckBox x:Name="StartAtLoginCheck" Content="Start ShadowWhispr when I log in"
                                      FontSize="13" VerticalAlignment="Center" IsCheckedChanged="StartAtLoginToggled" />
                            <TextBlock x:Name="StartupStatus" Classes="muted" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="MuteSoundCuesCheck" Content="Turn off the start and stop sounds"
                                  FontSize="13" IsCheckedChanged="SoundCuesToggled" />
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <CheckBox x:Name="AutoUpdateCheck" Content="Automatically check for updates"
                                      FontSize="13" VerticalAlignment="Center" IsCheckedChanged="AutoUpdateToggled" />
                            <Button x:Name="CheckUpdatesButton" Content="Check now" Classes="secondary"
                                    Padding="12,5" MinHeight="0" FontSize="12" Click="CheckForUpdatesClicked" />
                            <TextBlock x:Name="UpdateStatus" Classes="muted" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#1810141A"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14"
                            Padding="13,7" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="SaveDot" Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="SaveStatus" Text="Settings save automatically"
                                       Classes="muted" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- First-run speech setup overlay (shown only when the engine is missing) -->
        <Border x:Name="SetupBanner" IsVisible="False" Background="#D60A0D11" ZIndex="50">
            <Border Classes="card" MaxWidth="540" Margin="24"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="ONE-TIME SETUP" Classes="eyebrow" />
                    <TextBlock Text="Set up the speech engine" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="13" Margin="0,12,0,0" LineHeight="20"
                               Text="ShadowWhispr needs to download its local speech engine (about 2–3 GB). This happens once, into your own home folder — no root needed. An NVIDIA GPU is required." />
                    <Border Background="#141A1E14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="9" Padding="12,9" Margin="0,14,0,0">
                        <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="12"
                                   Text="You can leave this running and use your PC normally. Progress is shown here, and everything is also saved to setup-log.txt." />
                    </Border>

                    <StackPanel x:Name="SetupProgressPanel" IsVisible="False" Margin="0,18,0,0">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock x:Name="SetupStepText" Text="Starting setup…" FontSize="13"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SetupPercentText" Grid.Column="1" Text="0%" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                        <ProgressBar x:Name="SetupProgressBar" Height="10" CornerRadius="5" Minimum="0" Maximum="100"
                                     Foreground="{StaticResource GoldBrush}" Background="{StaticResource FieldBrush}" />
                        <TextBlock Text="Big downloads can sit on one step for a while — that's normal."
                                   Classes="muted" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0" Spacing="10">
                        <Button x:Name="SetupRunButton" Content="Set up speech now" Padding="20,11"
                                FontWeight="SemiBold" Click="SetupRunClicked" />
                        <Button x:Name="SetupLogButton" Content="Open setup log" Classes="secondary"
                                Padding="14,8" MinHeight="0" FontSize="12" IsVisible="False"
                                Click="OpenSetupLogClicked" />
                    </StackPanel>
                    <TextBlock x:Name="SetupStatus" Margin="1,12,0,0" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>
